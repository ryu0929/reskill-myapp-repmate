# Supabase project settings (Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# PostgreSQL connection strings used by Prisma
DATABASE_URL=
DIRECT_URL=

# Gemini API
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# true: fixed local responses / false: Gemini responses
# Production must use false. When omitted, the application also uses Gemini.
USE_MOCK_AI=true
